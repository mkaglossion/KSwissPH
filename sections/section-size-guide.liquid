{%- liquid
  assign section_id = section.id | prepend: 'Section-'
-%}

{{ 'section-size-guide.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #SizeGuide-{{ section.id }} .size-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  #SizeGuide-{{ section.id }} .size-table th,
  #SizeGuide-{{ section.id }} .size-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    font-size: 0.95rem;
  }

  #SizeGuide-{{ section.id }} .size-table th {
    background-color: rgba(var(--color-foreground), 0.05);
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.95);
  }

  #SizeGuide-{{ section.id }} .size-table tr:last-child td {
    border-bottom: none;
  }

  #SizeGuide-{{ section.id }} .size-trigger {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    color: var(--color-button);
    text-decoration: none;
    background: none;
    border: none;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    gap: 6px;
  }

  #SizeGuide-{{ section.id }} .size-trigger:hover {
    opacity: 0.8;
  }

  #SizeGuide-{{ section.id }} .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  #SizeGuide-{{ section.id }} .modal-overlay.active {
    display: flex;
  }

  #SizeGuide-{{ section.id }} .modal-content {
    background: var(--color-background);
    padding: 2rem;
    border-radius: 8px;
    max-width: 600px;
    max-height: 85vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  #SizeGuide-{{ section.id }} .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-foreground), 0.5);
  }

  #SizeGuide-{{ section.id }} .modal-close:hover {
    color: rgba(var(--color-foreground), 0.95);
  }

  #SizeGuide-{{ section.id }} .size-guide-note {
    background-color: rgba(39, 174, 96, 0.08);
    border-left: 4px solid #27AE60;
    padding: 12px 16px;
    border-radius: 4px;
    margin-top: 1rem;
    font-size: 0.9rem;
    color: rgba(var(--color-foreground), 0.8);
  }

  @media screen and (max-width: 749px) {
    #SizeGuide-{{ section.id }} .modal-content {
      padding: 1.5rem;
      max-height: 90vh;
    }

    #SizeGuide-{{ section.id }} .size-table {
      font-size: 0.85rem;
    }

    #SizeGuide-{{ section.id }} .size-table th,
    #SizeGuide-{{ section.id }} .size-table td {
      padding: 8px;
    }
  }
{%- endstyle -%}

<section
  class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  id="SizeGuide-{{ section.id }}"
>
  <div class="page-width">
    {% if section.settings.show_inline %}
      <div class="size-guide-content">
        <h2 class="title">{{ section.settings.title }}</h2>

        <table class="size-table">
          <thead>
            <tr>
              <th>US Size</th>
              <th>EU Size</th>
              <th>UK Size</th>
              <th>Length (cm)</th>
            </tr>
          </thead>
          <tbody>
            {% for block in section.blocks %}
              <tr>
                <td>{{ block.settings.us_size }}</td>
                <td>{{ block.settings.eu_size }}</td>
                <td>{{ block.settings.uk_size }}</td>
                <td>{{ block.settings.length_cm }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <p class="size-guide-note">{{ section.settings.guide_note }}</p>
      </div>
    {% else %}
      <button 
        class="size-trigger" 
        onclick="document.getElementById('SizeGuideModal-{{ section.id }}').classList.add('active')"
        aria-label="Open size guide"
      >
        📏 {{ section.settings.trigger_text }}
      </button>
    {% endif %}
  </div>

  <!-- Modal -->
  <div 
    id="SizeGuideModal-{{ section.id }}" 
    class="modal-overlay" 
    onclick="if(event.target === this) this.classList.remove('active')"
  >
    <div class="modal-content">
      <button 
        class="modal-close" 
        onclick="document.getElementById('SizeGuideModal-{{ section.id }}').classList.remove('active')"
        aria-label="Close size guide modal"
      >
        ✕
      </button>

      <h2 class="title">{{ section.settings.title }}</h2>

      <table class="size-table">
        <thead>
          <tr>
            <th>US Size</th>
            <th>EU Size</th>
            <th>UK Size</th>
            <th>Length (cm)</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            <tr>
              <td>{{ block.settings.us_size }}</td>
              <td>{{ block.settings.eu_size }}</td>
              <td>{{ block.settings.uk_size }}</td>
              <td>{{ block.settings.length_cm }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <p class="size-guide-note">{{ section.settings.guide_note }}</p>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('SizeGuideModal-{{ section.id }}');
    
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        modal.classList.remove('active');
      }
    });
  });
</script>

{% schema %}
{
  "name": "📏 Size Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "K-Swiss Size Guide"
    },
    {
      "type": "text",
      "id": "trigger_text",
      "label": "Button text (modal mode)",
      "default": "View Size Guide"
    },
    {
      "type": "richtext",
      "id": "guide_note",
      "label": "Additional notes",
      "default": "<p>Measurements are approximate. For best fit, measure the insole of a shoe that fits you well.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_inline",
      "label": "Show size table directly in section",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        { "value": "background-1", "label": "Default" },
        { "value": "background-2", "label": "Secondary" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Padding bottom"
    }
  ],
  "blocks": [
    {
      "type": "size_row",
      "name": "Size row",
      "settings": [
        { "type": "text", "id": "us_size", "label": "US Size", "default": "5" },
        { "type": "text", "id": "eu_size", "label": "EU Size", "default": "36" },
        { "type": "text", "id": "uk_size", "label": "UK Size", "default": "2.5" },
        { "type": "text", "id": "length_cm", "label": "Length (cm)", "default": "22.5" }
      ]
    }
  ],
  "presets": [
    { "name": "📏 Size Guide" }
  ]
}
{% endschema %}
