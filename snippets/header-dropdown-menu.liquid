{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- liquid
          assign has_extra_menu_section = false
          for block in section.blocks
            if block.type == 'extra_menu_section' and block.settings.main_menu == link.title
              assign has_extra_menu_section = true
            endif
          endfor
        -%}
        {%- if link.links != blank or has_extra_menu_section -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <a
                  href="{{ link.url }}"
                  class="header__menu-parent-link link link--text"
                  onclick="event.stopPropagation();"
                >
                  <span
                    {%- if link.child_active %}
                      class="header__active-menu-item"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </span>
                </a>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                 {%- for childlink in link.links -%}
                   <li>
                     {%- if childlink.links == blank -%}
                       <a
                         id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                         href="{{ childlink.url }}"
                         class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                         {% if childlink.current %}
                           aria-current="page"
                         {% endif %}
                       >
                         {{ childlink.title | escape }}
                       </a>
                     {%- else -%}
                       <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                         <summary
                           id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                           class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                         >
                           <span>{{ childlink.title | escape }}</span>
                           {{- 'icon-caret.svg' | inline_asset_content -}}
                         </summary>
                         <ul
                           id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                           class="header__submenu list-menu motion-reduce"
                         >
                           {%- for grandchildlink in childlink.links -%}
                             <li>
                               <a
                                 id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                 href="{{ grandchildlink.url }}"
                                 class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                 {% if grandchildlink.current %}
                                   aria-current="page"
                                 {% endif %}
                               >
                                 {{ grandchildlink.title | escape }}
                               </a>
                             </li>
                           {%- endfor -%}
                         </ul>
                       </details>
                     {%- endif -%}
                     {%- comment -%} Check for block image matching this submenu {%- endcomment -%}
                     {%- for block in section.blocks -%}
                       {%- if block.type == 'menu_image' -%}
                         {%- if block.settings.main_menu == link.title and block.settings.submenu_title == childlink.title and block.settings.section_image -%}
                           <div class="dropdown-submenu-image-wrapper">
                             {%- if block.settings.image_link != blank -%}
                               <a href="{{ block.settings.image_link }}" onclick="event.stopPropagation();">
                             {%- endif -%}
                             {% capture image_alt %}{{ childlink.title }}{% endcapture %}
                             {{
                               block.settings.section_image
                               | image_url: width: 300
                               | image_tag:
                                 class: 'dropdown-submenu-image',
                                 alt: image_alt,
                                 width: 200,
                                 height: 200,
                                 sizes: '200px',
                                 loading: 'lazy'
                             }}
                             {%- if block.settings.image_link != blank -%}
                               </a>
                             {%- endif -%}
                           </div>
                         {%- endif -%}
                       {%- endif -%}
                     {%- endfor -%}
                     {%- for block in section.blocks -%}
                       {%- if block.type == 'extra_menu_section' -%}
                         {%- liquid
                           assign extra_submenu_title = block.settings.submenu_title | strip | downcase
                           assign childlink_title = childlink.title | strip | downcase
                         -%}
                         {%- if block.settings.main_menu == link.title and extra_submenu_title != '__new_column' and extra_submenu_title == childlink_title -%}
                           <div class="header__nested-extra-section{% if block.settings.title == blank %} header__nested-extra-section--always-visible{% endif %}" {{ block.shopify_attributes }}>
                             {%- if block.settings.title != blank -%}
                               {%- if block.settings.title_link != blank -%}
                                 <a
                                   href="{{ block.settings.title_link }}"
                                   class="header__menu-item list-menu__item link link--text focus-inset caption-large header__submenu-extra-heading"
                                 >
                                   {{ block.settings.title | escape }}
                                 </a>
                               {%- else -%}
                                 <p class="header__menu-item list-menu__item caption-large header__submenu-extra-heading" tabindex="0">
                                   {{ block.settings.title | escape }}
                                 </p>
                               {%- endif -%}
                             {%- endif -%}

                             {%- if block.settings.menu != blank and block.settings.menu.links != blank -%}
                               <ul class="header__submenu-extra-list{% if block.settings.show_bullets %} header__submenu-extra-list--bullets{% endif %}" role="list">
                                 {%- for extra_link in block.settings.menu.links -%}
                                   <li>
                                     <a
                                       href="{{ extra_link.url }}"
                                       class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if extra_link.current %} list-menu__item--active{% endif %}"
                                       {% if extra_link.current %}
                                         aria-current="page"
                                       {% endif %}
                                     >
                                       {{ extra_link.title | escape }}
                                     </a>
                                   </li>
                                 {%- endfor -%}
                               </ul>
                             {%- endif -%}
                           </div>
                         {%- endif -%}
                       {%- endif -%}
                     {%- endfor -%}
                   </li>
                 {%- endfor -%}
                 {%- for block in section.blocks -%}
                   {%- if block.type == 'extra_menu_section' and block.settings.main_menu == link.title -%}
                     {%- liquid
                       assign extra_submenu_title = block.settings.submenu_title | strip
                     -%}
                     {%- if extra_submenu_title == blank or extra_submenu_title == '__new_column' -%}
                       <li class="header__submenu-extra-section{% if block.settings.title == blank %} header__submenu-extra-section--always-visible{% endif %}" {{ block.shopify_attributes }}>
                         {%- if block.settings.title != blank -%}
                           {%- if block.settings.title_link != blank -%}
                             <a
                               href="{{ block.settings.title_link }}"
                               class="header__menu-item list-menu__item link link--text focus-inset caption-large header__submenu-extra-heading"
                             >
                               {{ block.settings.title | escape }}
                             </a>
                           {%- else -%}
                             <p class="header__menu-item list-menu__item caption-large header__submenu-extra-heading" tabindex="0">
                               {{ block.settings.title | escape }}
                             </p>
                           {%- endif -%}
                         {%- endif -%}

                         {%- if block.settings.menu != blank and block.settings.menu.links != blank -%}
                           <ul class="header__submenu-extra-list{% if block.settings.show_bullets %} header__submenu-extra-list--bullets{% endif %}" role="list">
                             {%- for extra_link in block.settings.menu.links -%}
                               <li>
                                 <a
                                   href="{{ extra_link.url }}"
                                   class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if extra_link.current %} list-menu__item--active{% endif %}"
                                   {% if extra_link.current %}
                                     aria-current="page"
                                   {% endif %}
                                 >
                                   {{ extra_link.title | escape }}
                                 </a>
                               </li>
                             {%- endfor -%}
                           </ul>
                         {%- endif -%}
                       </li>
                       {%- endif -%}
                   {%- endif -%}
                 {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
