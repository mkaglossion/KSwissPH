{% comment %}
  Global-like custom PLP card
{% endcomment %}

{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
  {{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

<script src="{{ 'custom-card.js' | asset_url }}" defer="defer"></script>

{%- if card_product and card_product != empty -%}
  {% assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id %}

  {% assign size_option_index = nil %}
  {% assign color_option_index = nil %}

  {% for option in card_product.options_with_values %}
    {% assign option_name_downcase = option.name | downcase | strip %}

    {% if option_name_downcase == 'size'
      or option_name_downcase == 'shoe size'
      or option_name_downcase == 'shoes size'
      or option_name_downcase == 'us size'
      or option_name_downcase contains 'size'
    %}
      {% assign size_option_index = forloop.index0 %}
    {% endif %}

    {% if option_name_downcase == 'color'
      or option_name_downcase == 'colour'
      or option_name_downcase contains 'color'
      or option_name_downcase contains 'colour'
    %}
      {% assign color_option_index = forloop.index0 %}
    {% endif %}
  {% endfor %}

  {% assign short_title = card_product.metafields.custom.short_title %}
  {% if short_title == blank %}
    {% assign short_title = card_product.title %}
    {% assign short_title = short_title
      | replace: "WOMEN'S SHOES", ''
      | replace: "MEN'S SHOES", ''
      | replace: "KIDS' SHOES", ''
      | replace: "WOMEN SHOES", ''
      | replace: "MEN SHOES", ''
      | strip
    %}
  {% endif %}

  {% assign short_parts = short_title | split: ' - ' %}
  {% assign short_title = short_parts[0] | strip %}

  {% assign gender_label = card_product.metafields.custom.gender %}
  {% if gender_label == blank %}
    {% if card_product.tags contains 'Women' %}
      {% assign gender_label = 'WOMEN' %}
    {% elsif card_product.tags contains 'Men' %}
      {% assign gender_label = 'MEN' %}
    {% elsif card_product.tags contains 'Kids' %}
      {% assign gender_label = 'KIDS' %}
    {% endif %}
  {% endif %}

  {% assign current_variant = card_product.selected_or_first_available_variant %}
  {% assign second_image = blank %}
  {% if card_product.media.size > 1 %}
    {% assign second_image = card_product.media[1] %}
  {% endif %}

  <div class="card-wrapper product-card-wrapper underline-links-hover custom-plp-card-wrapper">
    <div
      class="card custom-plp-card"
      data-product-id="{{ card_product.id }}"
      data-product-url="{{ card_product.url }}"
      data-selected-variant-id="{{ current_variant.id }}"
    >
      <div class="custom-plp-card__inner">

        <div class="custom-plp-card__media-wrap">
          <a
            href="{{ card_product.url }}"
            class="custom-plp-card__media-link"
            aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }}"
          >
            {% if card_product.featured_media %}
              <div class="custom-plp-card__media">
                <img
                  srcset="
                    {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                    {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
                  "
                  src="{{ card_product.featured_media | image_url: width: 720 }}"
                  sizes="(min-width: 990px) calc((100vw - 140px) / 5), (min-width: 750px) calc((100vw - 80px) / 3), calc((100vw - 40px) / 2)"
                  alt="{{ card_product.featured_media.alt | escape }}"
                  class="custom-plp-card__main-image primary-image"
                  {% unless lazy_load == false %}
                    loading="lazy"
                  {% endunless %}
                  width="{{ card_product.featured_media.width }}"
                  height="{{ card_product.featured_media.height }}"
                >

                {% if second_image %}
                  <img
                    srcset="
                      {%- if second_image.width >= 165 -%}{{ second_image | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if second_image.width >= 360 -%}{{ second_image | image_url: width: 360 }} 360w,{%- endif -%}
                      {%- if second_image.width >= 533 -%}{{ second_image | image_url: width: 533 }} 533w,{%- endif -%}
                      {%- if second_image.width >= 720 -%}{{ second_image | image_url: width: 720 }} 720w,{%- endif -%}
                      {%- if second_image.width >= 940 -%}{{ second_image | image_url: width: 940 }} 940w,{%- endif -%}
                      {%- if second_image.width >= 1066 -%}{{ second_image | image_url: width: 1066 }} 1066w,{%- endif -%}
                      {{ second_image | image_url }} {{ second_image.width }}w
                    "
                    src="{{ second_image | image_url: width: 720 }}"
                    sizes="(min-width: 990px) calc((100vw - 140px) / 5), (min-width: 750px) calc((100vw - 80px) / 3), calc((100vw - 40px) / 2)"
                    alt="{{ second_image.alt | escape }}"
                    class="custom-plp-card__main-image hover-image"
                    loading="lazy"
                    width="{{ second_image.width }}"
                    height="{{ second_image.height }}"
                  >
                {% endif %}
              </div>
            {% endif %}
          </a>
        </div>

        <div class="custom-plp-card__content">
          {% if gender_label != blank %}
            <div class="custom-plp-card__gender">{{ gender_label }}</div>
          {% endif %}

          <h3 class="custom-plp-card__title" id="title-{{ section_id }}-{{ card_product.id }}">
            <a href="{{ card_product.url }}" id="CardLink-{{ section_id }}-{{ card_product.id }}" class="full-unstyled-link">
              {{ short_title | escape }}
            </a>
          </h3>

          <div class="custom-plp-card__price">
            {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
          </div>

          {% if size_option_index != nil %}
            <div class="quick_atc_wrap">
              <div class="quick_atc_box">
                <div class="quick_atc_grid" data-scroll-init="true">
                {% for variant in card_product.variants %}
                  {% assign size_value = variant.options[size_option_index] %}
                  {% assign variant_color_value = '' %}
                  {% if color_option_index != nil %}
                    {% assign variant_color_value = variant.options[color_option_index] %}
                  {% endif %}

                  <button
                    type="button"
                    class="variant-btn{% unless variant.available %} disabled is-disabled{% endunless %}{% if current_variant.id == variant.id %} active is-active{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-size="{{ size_value | escape }}"
                    data-color="{{ variant_color_value | escape }}"
                    {% unless variant.available %}disabled{% endunless %}
                    {% if color_option_index != nil and current_variant.options[color_option_index] != variant_color_value %}hidden{% endif %}
                  >
                    {{ size_value }}
                  </button>
                {% endfor %}
              </div>
            </div>
            </div>
          {% endif %}

          <div class="custom-plp-card__quick-add">
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product', card_product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id" {% if current_variant.available == false %}disabled{% endif %}>
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit button button--full-width custom-plp-card__atc"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  aria-live="polite"
                  data-sold-out-message="true"
                  {% if current_variant.available == false %}disabled{% endif %}
                >
                  <span>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>
          </div>

          {% assign sibling_products = card_product.metafields.custom.sibling_products.value %}
          {% assign color_items = sibling_products %}
          {% assign color_count = 0 %}

          {% if color_items != blank %}
            {% assign color_count = color_items.count %}
          {% endif %}

          {% if color_count == 0 %}
            {% assign color_count = 1 %}
          {% endif %}

          <div class="custom-plp-card__colors-count">
            {{ color_count }} Color{% if color_count > 1 %}s{% endif %}
          </div>

          <div class="custom-plp-card__color-label">
            <strong>Color:</strong>
            {% assign color_list = '' %}
            {% if sibling_products != blank and sibling_products.size > 0 %}
              {% for p in sibling_products %}
                {% assign parts = p.title | split: ' - ' %}
                {% for part in parts %}{% assign color_name = part %}{% endfor %}
                {% assign color_name = color_name | strip %}
                {% if forloop.first %}
                  {% assign color_list = color_name %}
                {% else %}
                  {% assign color_list = color_list | append: ' / ' | append: color_name %}
                {% endif %}
              {% endfor %}
            {% else %}
              {% assign parts = card_product.title | split: ' - ' %}
              {% for part in parts %}{% assign color_name = part %}{% endfor %}
              {% assign color_list = color_name | strip %}
            {% endif %}
            <span class="active-color-name">{{ color_list }}</span>
          </div>

          <div class="collection-siblings">
            <div class="color_swatch_wrap">
              <div class="color_swatch_box">
                <div class="collection-siblings__grid" role="list" aria-label="Color swatches">
                  {% if sibling_products != blank and sibling_products.count > 0 %}
                    {% for product in sibling_products %}
                      {% assign prod_parts = product.title | split: ' - ' %}
                      {% assign prod_color_name = prod_parts | last | strip %}
                      <button
                        type="button"
                        role="listitem"
                        class="card-swatch{% if product.id == card_product.id %} is-active active{% endif %}"
                        aria-label="Select color {{ prod_color_name | escape }}"
                        aria-pressed="{% if product.id == card_product.id %}true{% else %}false{% endif %}"
                        data-url="{{ product.url }}"
                        data-image="{{ product.featured_image | image_url: width: 720 }}"
                        data-color-name="{{ prod_color_name }}"
                      >
                        <img src="{{ product.featured_image | image_url: width: 120 }}" width="70" height="52" alt="{{ product.title | escape }}">
                      </button>
                    {% endfor %}
                  {% else %}
                    {% assign current_prod_parts = card_product.title | split: ' - ' %}
                    {% assign current_prod_color = current_prod_parts | last | strip %}
                    <button
                      type="button"
                      role="listitem"
                      class="card-swatch is-active active"
                      aria-label="Select color {{ current_prod_color | escape }}"
                      aria-pressed="true"
                      data-url="{{ card_product.url }}"
                      data-image="{{ card_product.featured_image | image_url: width: 720 }}"
                      data-color-name="{{ current_prod_color }}"
                    >
                      <img src="{{ card_product.featured_image | image_url: width: 120 }}" width="70" height="52" alt="{{ card_product.title | escape }}">
                    </button>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          
        </div>
        
        {% assign is_new_badge = false %}
        {% if card_product.tags contains 'New' or card_product.tags contains 'NEW' or card_product.tags contains 'new' %}
          {% assign is_new_badge = true %}
        {% endif %}

        <div class="card__badge {{ settings.badge_position }}">
          {%- if is_new_badge -%}
            <span id="NewBadge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left">NEW</span>
          {%- endif -%}
          {%- if card_product.available == false -%}
            <span id="SoldOutBadge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">{{- 'products.product.sold_out' | t -}}</span>
          {%- endif -%}
          {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
            <span id="SaleBadge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">{{- 'products.product.on_sale' | t -}}</span>
          {%- endif -%}
        </div>
        
      </div>
    </div>
  </div>

{%- else -%}
  <div class="card-wrapper product-card-wrapper underline-links-hover">
    <div class="card">
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading card__heading--placeholder h5">
            <a role="link" aria-disabled="true" class="full-unstyled-link">{{ 'onboarding.product_title' | t }}</a>
          </h3>
          <div class="card-information">
            {% render 'price', placeholder: true, show_compare_at_price: true %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}